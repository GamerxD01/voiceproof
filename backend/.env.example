# VoiceProof Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Hardware inference device: 'cpu' (default) or 'cuda' (if NVIDIA GPU and CUDA PyTorch installed)
DEVICE=cpu
USE_CUDA=false

# Allowed CORS origins (comma-separated).
# For local development: http://localhost:5173,http://127.0.0.1:5173
# For production: Add your production frontend domain, e.g., https://voiceproof.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Path to the fine-tuned model artifacts directory (relative or absolute)
MODEL_DIR=../model

# Maximum audio upload size in bytes (default: 25MB)
MAX_AUDIO_FILE_SIZE=26214400
